# GitHub Personal Access Token, scoped to ONLY the "gist" permission.
# Create at: https://github.com/settings/tokens -> Generate new token (classic) -> check only "gist"
GITHUB_TOKEN=

# Leave blank on first run — publish-usage.js will create a private gist and
# print the id to paste back in here. Once set, future runs update that gist
# instead of creating new ones.
GIST_ID=
